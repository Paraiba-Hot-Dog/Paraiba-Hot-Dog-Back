FROM quay.io/keycloak/keycloak:26.0

# Copia a configuração do realm para importação automática na primeira inicialização
COPY keycloak/paraiba-hotdog-realm.json /opt/keycloak/data/import/paraiba-hotdog-realm.json

EXPOSE 8080

# start-dev: aceita conexão HTTP (Render faz o HTTPS por fora)
# --import-realm: importa o realm.json se ele ainda não existir no banco
CMD ["start-dev", "--import-realm"]
